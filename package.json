{
  "name": "relay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "up": "docker compose up -d --build --wait",
    "down": "docker compose down -v",
    "load": "docker compose --profile loadtest run --rm k6",
    "e2e": "bash scripts/e2e.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
